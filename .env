# ============================================================
# ORHA Money & Retention Dashboard – Environment Config
# ============================================================

# API Server
API_PORT=3001
NODE_ENV=development

# Data storage directory (JSON file store for MVP)
# DATA_DIR=./api/data

# Azure AD / Teams SSO (fill in for production)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# Admin AAD Group Object ID (members of this group get admin access)
# ADMIN_GROUP_ID=

# Azure Storage (for production blob/table storage)
# AZURE_STORAGE_CONNECTION_STRING=
